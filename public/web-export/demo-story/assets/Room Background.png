<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="800" height="600">
  <defs>
    <linearGradient id="wallGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#2d3748" />
      <stop offset="100%" stop-color="#1a202c" />
    </linearGradient>
    <linearGradient id="floorGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#744210" />
      <stop offset="100%" stop-color="#553c9a" />
    </linearGradient>
    <linearGradient id="windowGlow" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#63b3ed" stop-opacity="0.8" />
      <stop offset="100%" stop-color="#ebf8ff" stop-opacity="0.2" />
    </linearGradient>
  </defs>

  <!-- Wall -->
  <rect width="800" height="420" fill="url(#wallGrad)" />

  <!-- Floor -->
  <polygon points="0,420 800,420 800,600 0,600" fill="#382414" />
  <line x1="0" y1="420" x2="800" y2="420" stroke="#718096" stroke-width="4" />

  <!-- Floor Planks -->
  <line x1="160" y1="420" x2="100" y2="600" stroke="#2d1c0f" stroke-width="2" opacity="0.6"/>
  <line x1="360" y1="420" x2="320" y2="600" stroke="#2d1c0f" stroke-width="2" opacity="0.6"/>
  <line x1="560" y1="420" x2="580" y2="600" stroke="#2d1c0f" stroke-width="2" opacity="0.6"/>
  <line x1="720" y1="420" x2="780" y2="600" stroke="#2d1c0f" stroke-width="2" opacity="0.6"/>

  <!-- Window -->
  <rect x="80" y="60" width="180" height="220" rx="8" fill="#1a365d" stroke="#a0aec0" stroke-width="6" />
  <rect x="85" y="65" width="170" height="210" rx="4" fill="url(#windowGlow)" />
  <line x1="170" y1="65" x2="170" y2="275" stroke="#a0aec0" stroke-width="4" />
  <line x1="85" y1="170" x2="255" y2="170" stroke="#a0aec0" stroke-width="4" />

  <!-- Stars in Window -->
  <circle cx="120" cy="100" r="2" fill="#fff" opacity="0.9" />
  <circle cx="150" cy="140" r="1.5" fill="#fff" opacity="0.8" />
  <circle cx="210" cy="90" r="2.5" fill="#fff" opacity="0.9" />
  <circle cx="230" cy="130" r="1.5" fill="#fff" opacity="0.7" />

  <!-- Wall Shelf -->
  <rect x="520" y="140" width="200" height="12" rx="3" fill="#4a5568" stroke="#718096" stroke-width="2" />
  <!-- Books on shelf -->
  <rect x="540" y="90" width="22" height="50" rx="2" fill="#e53e3e" />
  <rect x="566" y="80" width="18" height="60" rx="2" fill="#3182ce" />
  <rect x="588" y="100" width="24" height="40" rx="2" fill="#38a169" />
  <rect x="616" y="85" width="20" height="55" rx="2" fill="#d69e2e" />

  <!-- Ambient lighting overlay -->
  <rect width="800" height="600" fill="#3182ce" opacity="0.05" />
</svg>
