<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 600" width="400" height="600">
  <defs>
    <linearGradient id="hairGradSad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#c05621" />
      <stop offset="100%" stop-color="#7b341e" />
    </linearGradient>
    <linearGradient id="jacketGradSad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#2b6cb0" />
      <stop offset="100%" stop-color="#1a365d" />
    </linearGradient>
    <linearGradient id="skinGradSad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#fed7aa" />
      <stop offset="100%" stop-color="#fbd38d" />
    </linearGradient>
  </defs>

  <!-- Body / Clothes -->
  <path d="M 120 400 Q 200 380 280 400 L 330 600 L 70 600 Z" fill="url(#jacketGradSad)" stroke="#1a365d" stroke-width="4" />
  
  <!-- Shirt Collar -->
  <polygon points="200,410 160,370 240,370" fill="#edf2f7" stroke="#cbd5e0" stroke-width="2" />
  <polygon points="175,370 200,430 190,430" fill="#cbd5e0" />
  <polygon points="225,370 200,430 210,430" fill="#cbd5e0" />

  <!-- Neck -->
  <rect x="175" y="320" width="50" height="70" rx="8" fill="url(#skinGradSad)" stroke="#dd6b20" stroke-width="1.5" />

  <!-- Head Base -->
  <ellipse cx="200" cy="270" rx="65" ry="75" fill="url(#skinGradSad)" stroke="#dd6b20" stroke-width="2" />

  <!-- Hair Back -->
  <path d="M 115 260 Q 90 360 140 380 Q 200 400 260 380 Q 310 360 285 260 Z" fill="url(#hairGradSad)" />

  <!-- Ears -->
  <ellipse cx="132" cy="275" rx="10" ry="16" fill="url(#skinGradSad)" />
  <ellipse cx="268" cy="275" rx="10" ry="16" fill="url(#skinGradSad)" />

  <!-- Hair Top & Bangs -->
  <path d="M 130 250 C 130 160 270 160 270 250 C 275 220 250 190 200 185 C 150 190 125 220 130 250 Z" fill="url(#hairGradSad)" stroke="#7b341e" stroke-width="2" />
  <path d="M 135 220 Q 170 260 180 230 Q 200 270 220 230 Q 240 260 265 225 C 240 180 160 180 135 220 Z" fill="url(#hairGradSad)" />

  <!-- Sad Eyebrows (slanted upwards in center) -->
  <path d="M 155 235 Q 170 242 185 236" fill="none" stroke="#7b341e" stroke-width="4" stroke-linecap="round" />
  <path d="M 215 236 Q 230 242 245 235" fill="none" stroke="#7b341e" stroke-width="4" stroke-linecap="round" />

  <!-- Sad Eyes (droopy) -->
  <ellipse cx="170" cy="265" rx="8" ry="10" fill="#2d3748" />
  <circle cx="168" cy="262" r="3" fill="#fff" />
  <ellipse cx="230" cy="265" rx="8" ry="10" fill="#2d3748" />
  <circle cx="228" cy="262" r="3" fill="#fff" />

  <!-- Tear -->
  <path d="M 160 276 Q 158 290 162 292 Q 166 290 162 276 Z" fill="#63b3ed" opacity="0.8" />

  <!-- Nose -->
  <path d="M 197 275 Q 200 282 203 282" fill="none" stroke="#dd6b20" stroke-width="2.5" stroke-linecap="round" />

  <!-- Sad Frown Mouth -->
  <path d="M 185 310 Q 200 298 215 310" fill="none" stroke="#9b2c2c" stroke-width="3" stroke-linecap="round" />
</svg>
